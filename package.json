{
  "name": "chrome-ai-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"node scripts/watch-iife.js\"",
    "build": "vite build && node build-extension.js",
    "build:win": "DIST_DIR=/mnt/d/chrome/chrome-ai-reader npm run build",
    "lint": "eslint src/ proxy/ scripts/ build-extension.js vite.config.js vitest.config.js eslint.config.js && npm run lint:deps",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write 'src/**/*.js' 'proxy/**/*.js'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@esbuild-kit/esm-loader": "^2.6.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@mozilla/readability": "^0.5.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.77.0",
    "marked": "^15.0.0",
    "motion": "^14.14.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
