{
  "name": "chrome-ai-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"node scripts/watch-iife.js\"",
    "build": "vite build && node build-extension.js",
    "lint": "eslint src/ proxy/",
    "format": "prettier --write 'src/**/*.js' 'proxy/**/*.js'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@esbuild-kit/esm-loader": "^2.6.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/chrome": "^0.1.42",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "marked": "^15.0.0"
  }
}
